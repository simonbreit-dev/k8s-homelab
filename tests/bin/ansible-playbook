#!/usr/bin/env python3
"""Stub readiness and device deletion only during Terraform mock tests."""

from pathlib import Path
import sys

assert Path.cwd().name == "ansible", Path.cwd()
if sys.argv[1:] == ["-i", "localhost,", "-c", "local",
                     "playbooks/delete-tailnet-device.yml", "-e",
                     "tailscale_device_id=nodeidTEST"]:
    print("Mocked exact-device cleanup")
else:
    assert len(sys.argv) == 4, sys.argv
    assert sys.argv[1] == "-i", sys.argv
    assert sys.argv[2] in (
        "test-node,", "test-new-node,",
        "k8s-lab-node-1,", "k8s-lab-node-2,", "k8s-lab-node-3,",
    ), sys.argv
    assert sys.argv[3] == "playbooks/wait-for-cloud-init.yml", sys.argv
    print("Mocked server boot readiness")
