---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration

discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ hostvars[groups['control_plane'][0]].k8s_node_ip }}:6443"
    token: "{{ hostvars[groups['control_plane'][0]].kubernetes_join_token }}"

    caCertHashes:
      - "sha256:{{ hostvars[groups['control_plane'][0]].kubernetes_ca_hash }}"

nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: "unix:///var/run/containerd/containerd.sock"

  kubeletExtraArgs:
    - name: node-ip
      value: "{{ k8s_node_ip }}"
